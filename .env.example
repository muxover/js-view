# Process role: "api" runs the HTTP server, "worker" runs a queue consumer,
# "all" runs both in a single process (good for local dev / single-container).
JSVIEW_ROLE=all

# HTTP server
PORT=8080
HOST=0.0.0.0

# Max requests per window per IP (rate limiting)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Security
# When set, /render and /sessions require this key via "Authorization: Bearer <key>"
# or an "x-api-key" header. Empty = open (fine for a private/local instance).
API_KEY=
# Refuse to fetch localhost / private-network addresses (SSRF guard). Keep on
# for any internet-facing instance; turn off only for trusted internal use.
BLOCK_PRIVATE_HOSTS=true

# Rendering defaults
DEFAULT_TIMEOUT_MS=15000
MAX_TIMEOUT_MS=60000
DEFAULT_WAIT_UNTIL=networkidle
DEFAULT_OUTPUT_FORMAT=markdown

# Browser pool
BROWSER_POOL_SIZE=2
# Recycle a browser after this many renders to bound memory growth.
BROWSER_MAX_USES=50
# Run with a visible browser window when true (headful fallback / debugging).
HEADFUL=false
# Launch Chromium with --no-sandbox. Required as root in most containers; set
# false to keep the sandbox where the host allows an unprivileged user.
BROWSER_NO_SANDBOX=true

# Anti-detection
STEALTH_ENABLED=true
# Comma-separated list of user agents to rotate through. Empty = built-in list.
USER_AGENTS=
RANDOMIZE_VIEWPORT=true
# Optional default proxy, e.g. http://user:pass@host:port
PROXY_URL=

# Sessions
# Directory where persistent storage state (cookies/localStorage) is saved.
SESSION_DIR=./sessions

# Queue / scaling
# When set, renders are dispatched through a BullMQ queue backed by Redis.
# Leave REDIS_URL empty to run renders inline (no queue, single process).
REDIS_URL=
QUEUE_NAME=jsview-render
QUEUE_CONCURRENCY=2

# Tesseract language(s) for screenshot OCR, e.g. "eng" or "eng+fra".
OCR_LANG=eng

# Shut the service down after this many ms with no activity. 0 disables it.
# The skill sets this automatically when it auto-starts the service.
IDLE_SHUTDOWN_MS=0

LOG_LEVEL=info
