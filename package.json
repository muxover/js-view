{
  "name": "js-view",
  "version": "1.0.0",
  "description": "Headless-browser rendering service that runs a page's JavaScript and returns the rendered content.",
  "type": "module",
  "license": "MIT",
  "author": "Jax (@muxover)",
  "repository": {
    "type": "git",
    "url": "https://github.com/muxover/js-view"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "cross-env JSVIEW_ROLE=worker tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "cross-env JSVIEW_ROLE=worker node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "bullmq": "^5.12.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.4.1",
    "jsdom": "^29.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright": "^1.46.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.0",
    "@types/turndown": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
